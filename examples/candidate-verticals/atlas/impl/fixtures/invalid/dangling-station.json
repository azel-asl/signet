  "rules": [
    {
      "id": "R01",
      "kind": "station_capacity",
      "description": "effective capacity = 0 if a staffing-required station has no assigned on-shift employee; otherwise min(sum of capacity of attached equipment whose status is not DOWN, staff_count * per_staff_concurrency)."
    },
    {
      "id": "R02",
      "kind": "queue_discipline",
      "description": "FIFO by (queued_t, order created_t, work_id). No preemption. No priority classes in V0."
    },
    {
      "id": "R03",
      "kind": "no_preemption",
      "description": "Work in progress always finishes, even if capacity drops below the in-progress count. No new work starts while in_progress >= effective capacity."
    },
    {
      "id": "R04",
      "kind": "single_assignment",
      "description": "An employee is assigned to at most one station at a time. A reassignment takes effect at the event time; in-progress work at the old station continues (R03)."
    },
    {
      "id": "R05",
      "kind": "assembly_barrier",
      "description": "The order-level pass step is queued only when every item's last kitchen step is complete (immediately at creation for orders with no kitchen steps)."
    },
    {
      "id": "R06",
      "kind": "handoff",
      "description": "ORDER_COMPLETED occurs handoff_s after ORDER_READY. No staff needed."
    },
    {
      "id": "R07",
      "kind": "station_status",
      "description": "UNSTAFFED if staff=0 and queue>0; OVERLOADED if queue_len >= overload_queue or oldest queued wait >= overload_wait_s; BUSY if in_progress >= effective capacity and capacity>0; else NORMAL."
    },
    {
      "id": "R08",
      "kind": "skills_required",
      "description": "An employee may only be assigned to a station listed in their skills. Violations are rejected at validation, not silently ignored."
    },
    {
      "id": "R09",
      "kind": "no_balking",
      "description": "V0 models no lost demand: every created order is eventually served. Revenue differences between branches are timing differences, not gained revenue."
    }
  ],

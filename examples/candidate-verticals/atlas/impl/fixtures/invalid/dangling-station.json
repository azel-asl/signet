    },
    {
      "id": "avg_kitchen_time_s",
      "unit": "s",
      "definition": "mean(completed_t - created_t) over orders completed in (t-900, t]; null if none"
    },
    {
      "id": "p90_kitchen_time_s",
      "unit": "s",
      "definition": "90th percentile (nearest-rank) of the same set; null if none"
    },
    {
      "id": "over_target_share",
      "unit": "ratio",
      "definition": "share of orders completed in (t-900, t] with kitchen time > goal g_kitchen_time target; null if none"
    },
    {
      "id": "revenue_completed",
      "unit": "USD",
      "definition": "sum of totals of COMPLETED orders (cumulative)"
    },
    {
      "id": "station.queue_len",
      "unit": "count",
      "definition": "work items QUEUED at the station at t"
    },
    {
      "id": "station.in_progress",
      "unit": "count",
      "definition": "work items IN_PROGRESS at the station at t"
    },
    {
      "id": "station.oldest_wait_s",
      "unit": "s",
      "definition": "t - min(queued_t) over QUEUED work at the station; 0 if empty"
    },
    {
      "id": "station.utilization",
      "unit": "ratio",
      "definition": "busy slot-seconds / integral of effective capacity over (t-900, t]; null if capacity integral is 0"
    }
  ],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalworks.dev/atlas/schema/atlas-diagnosis/0.1",
  "title": "ATLAS Diagnosis (atlas-diagnosis/0.1)",
  "description": "Structured, evidence-linked diagnosis of one WorldState at one (branch, t) (18 §C). Claims form a DAG via links. No claim asserts causation; relations are supports, limited_by and blocks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["atlas_schema", "diagnosis_id", "diagnostics_version", "packs", "world", "context", "claims", "roots", "diagnosis_hash"],
  "properties": {
    "atlas_schema": { "const": "atlas-diagnosis/0.1" },
    "diagnosis_id": { "type": "string", "pattern": "^dx_[0-9a-f]{16}$" },
    "diagnostics_version": { "type": "string" },
    "packs": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "version", "requires_rule_kinds"], "properties": { "id": { "type": "string" }, "version": { "type": "string" }, "requires_rule_kinds": { "type": "array", "items": { "type": "string" } } } } },
    "world": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string" } } },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "mode", "claim_class", "t", "ts", "window_s", "snapshot_state_hash", "ledger_events_applied"],
      "properties": {
        "branch": { "type": "string", "pattern": "^(history|sim):[a-z0-9_-]+$" },
        "mode": { "enum": ["RECONSTRUCT", "SIMULATE"] },
        "claim_class": { "enum": ["derived", "simulated"] },
        "t": { "type": "integer" }, "ts": { "type": "string" },
        "window_s": { "const": 900 },
        "snapshot_state_hash": { "$ref": "#/$defs/hash" },
        "ledger_events_applied": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "RECONSTRUCT" } } }, "then": { "properties": { "claim_class": { "const": "derived" }, "branch": { "type": "string", "pattern": "^history:" } } } },
        { "if": { "properties": { "mode": { "const": "SIMULATE" } } }, "then": { "properties": { "claim_class": { "const": "simulated" }, "branch": { "type": "string", "pattern": "^sim:" } } } }
      ]
    },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "roots": { "type": "array", "items": { "type": "string" } },
    "diagnosis_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ref": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "event_id"], "properties": { "kind": { "const": "event" }, "event_id": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "state" }, "path": { "type": "string", "pattern": "^/(state|metrics)/" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "world" }, "path": { "type": "string", "pattern": "^/" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "rule"], "properties": { "kind": { "const": "world_rule" }, "rule": { "type": "string", "pattern": "^R[0-9]{2}$" } } }
      ]
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "role", "subject", "template", "values", "basis", "rule", "claim_class", "support", "confidence", "assumptions", "evidence", "links"],
      "properties": {
        "id": { "type": "string", "pattern": "^c:[a-z_]+:[a-z0-9_-]+$" },
        "kind": { "enum": ["overload", "backlog", "backlog_growth", "at_capacity", "capacity_limit", "demand_vs_capacity", "equipment_degradation", "assembly_blocking", "unknown"] },
        "role": { "enum": ["symptom", "condition", "limitation", "non_limitation", "downstream_effect", "unknown"] },
        "subject": { "type": "string" },
        "template": { "type": "string", "pattern": "^T_[A-Z_]+$" },
        "values": { "type": "object" },
        "basis": { "enum": ["state", "rule", "structure", "inference"] },
        "rule": { "type": "object", "additionalProperties": false, "required": ["id", "version", "world_rules"], "properties": { "id": { "type": "string" }, "version": { "type": "string" }, "world_rules": { "type": "array", "items": { "type": "string", "pattern": "^R[0-9]{2}$" } } } },
        "claim_class": { "enum": ["derived", "simulated", "inferred"] },
        "support": { "enum": ["deterministic", "bounded", "none"] },
        "confidence": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["value", "method"], "properties": { "value": { "type": "number", "minimum": 0, "maximum": 1 }, "method": { "type": "string" } } }] },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "links": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["rel", "to"], "properties": { "rel": { "enum": ["supports", "limited_by", "blocks"] }, "to": { "type": "string" } } } },
        "onset_t": { "type": ["integer", "null"] },
        "onset_in_parent": { "type": "boolean" },
        "reason": { "enum": ["MODEL_UNEXPLAINED_IDLE", "RULE_NOT_APPLICABLE", "MISSING_RELATIONSHIP", "INSUFFICIENT_WINDOW", "CONFLICTING_FACTS"] }
      },
      "allOf": [
        { "if": { "properties": { "basis": { "const": "inference" } } }, "then": { "required": ["confidence"], "properties": { "claim_class": { "const": "inferred" }, "support": { "const": "bounded" }, "confidence": { "type": "object" } } }, "else": { "properties": { "claim_class": { "enum": ["derived", "simulated"] }, "confidence": { "type": "null" } } } },
        { "if": { "properties": { "kind": { "const": "unknown" } } }, "then": { "required": ["reason"], "properties": { "id": { "type": "string", "pattern": "^c:unknown_(model_unexplained_idle|rule_not_applicable|missing_relationship|insufficient_window|conflicting_facts):[a-z0-9_-]+$" }, "role": { "const": "unknown" }, "support": { "const": "none" } } }, "else": { "properties": { "id": { "type": "string", "pattern": "^c:(overload|backlog|backlog_growth|demand_vs_capacity|at_capacity|capacity_limit|equipment_degradation|assembly_blocking):[a-z0-9_-]+$" }, "evidence": { "type": "array", "minItems": 1 } } } }
      ]
    }
  }
}

{
  "$comment": "Shape of a Signet receipt. Receipts are GENERATED by `signet run` — do not hand-write them. This template documents the fields a verifier reads. See examples/receipt.verified.json and examples/demo-phi-transfer.receipt.json for real, verifiable receipts.",
  "receipt_version": "signet-receipt-v1",
  "receipt_id": "<generated>",
  "parent_receipt_id": null,
  "packet": {
    "id": "<packet META.id>",
    "sha256": "<hash of the packet>",
    "tier": 1,
    "type": "review|build|deploy"
  },
  "action": "governed_run",
  "verdict": "allowed|warned|blocked",
  "outcome": "complete|failed",
  "summary": {
    "tasks_total": 0,
    "tasks_complete": 0,
    "tasks_blocked": 0,
    "tasks_skipped": 0,
    "tasks_failed": 0,
    "blocks_recorded": 0,
    "gates_passed": 0,
    "gates_failed": 0,
    "gates_unevaluated": 0,
    "ats_passed": 0,
    "ats_failed": 0,
    "ats_unevaluated": 0
  },
  "task_results": [],
  "block_events": [],
  "gate_results": [],
  "behavioral_reports": [],
  "timestamps": { "generated_at": "<ISO8601>" },
  "canon": "XAS-CANON-1",
  "hashes": {
    "sha256": "<byte integrity of the whole receipt>",
    "h10": "<semantic core: verdict, tasks, blocks>"
  },
  "signature": null
}
